{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "orivia-research-pilot",
  "main": "index.mjs",
  "account_id": "dca77f1ed4a6d4407bc82e27b4581f7d",
  "compatibility_date": "2026-10-18",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "ai": {
    "binding": "AI"
  },
  "browser": {
    "binding": "BROWSER"
  },
  "d1_databases": [
    {
      "binding": "BUDGET_DB",
      "database_name": "orivia-beta-budget",
      "database_id": "bd521420-65a0-4b7d-9bf2-801010c7ca86"
    }
  ],
  "ratelimits": [
    {
      "name": "AI_QUOTA",
      "namespace_id": "602114",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  // Files (step 6): the pilot's own private bucket, never production's.
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "orivia-files-pilot" }],
  "vars": {
    "FILES_ENABLED": "1",
    "PRIVATE_HOST": "orivia-research-pilot.habeebahsallah27.workers.dev",
    "ACCESS_TEAM_DOMAIN": "shy-rain-efa9.cloudflareaccess.com",
    "ACCESS_AUD": "dbdcd14c948acf07a9ecc9d720e19c6fcf455922f66704221fa2f80db9c21028",
    "RESEARCH_ENABLED": "1",
    "RESEARCH_LOOP": "1",
    "RESEARCH_AGENT": "1",
    "SEARCH_POOL": "pilot",
    "SEARCH_DAILY_CAP": "150",
    "SEARCH_MONTHLY_CAP": "1000",
    "RESEARCH_TURN_SEARCHES": "8",
    "RESEARCH_TURN_FETCHES": "32",
    "RESEARCH_AGENT_STEPS": "12",
    "SPEA_DIRECTORY_FEED": "1",
    "DAILY_CAP": "60",
    "ASSISTANT_DAILY_CAP": "300",
    "OPENAI_PILOT": "1",
    "BROWSER_DIRECTORY": "0",
    "OPENAI_INPUT_USD_PER_M": "2",
    "OPENAI_OUTPUT_USD_PER_M": "10",
    "PILOT_OPENAI_DAY_USD": "5",
    "PILOT_OPENAI_MONTH_USD": "20",
    // Natural voice for Listen (founder-approved 22 Oct): $1/day and $5/month of its own, also counted inside the OpenAI
    // limits above. gpt-realtime-2.1-mini prices checked 22 Oct (USD per 1M tokens). Pilot only until the founder says so.
    "VOICE_ENABLED": "1", "VOICE_DAY_USD": "1", "VOICE_MONTH_USD": "5",
    "VOICE_TEXT_IN_USD_PER_M": "0.6", "VOICE_TEXT_OUT_USD_PER_M": "2.4", "VOICE_AUDIO_OUT_USD_PER_M": "20",
    "BROWSER_DAY_SECONDS": "0",
    "BROWSER_MONTH_SECONDS": "0"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false
    },
    "head_sampling_rate": 1
  }
}
