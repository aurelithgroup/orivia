[
 {
  "name": "upd-busy",
  "path": "?view=chat",
  "wait": 3000,
  "js": "(async()=>{const real=window.fetch;window.fetch=(u,o)=>String(u).startsWith('/v1/chat')?new Promise(r=>setTimeout(()=>r(new Response(JSON.stringify({reply:'ok'}),{headers:{'Content-Type':'application/json'}})),1500)):real(u,o);document.getElementById('msg').value='Question';document.getElementById('form').requestSubmit();await new Promise(r=>setTimeout(r,200));document.getElementById('msg').value='half typed';const refused=window.OriviaUpdate.reloadKeepingDraft(null);const status=document.getElementById('status').textContent;await new Promise(r=>setTimeout(r,1600));return JSON.stringify({refused:refused===false,status})})()"
 },
 {
  "name": "upd-save",
  "path": "?view=chat",
  "wait": 3000,
  "keep": true,
  "js": "(()=>{document.getElementById('msg').value='My unsent question about the visa medical';window.OriviaUpdate.reloadKeepingDraft(null);return 'reloading'})()",
  "after": 3000,
  "check": "JSON.stringify({composer:document.getElementById('msg').value,status:document.getElementById('status').textContent,draftKeyLeft:Object.keys(sessionStorage).some(k=>k.startsWith('orivia-update-draft')),chatTab:document.querySelector('[aria-current=page],[aria-selected=true]')?.textContent?.trim()||null})"
 }
]